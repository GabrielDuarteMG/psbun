@@ -52,7 +52,8 @@ namespace WTF {
 // USE(64KB_PAGE_BLOCK) allows overriding this on other architectures too.
 //
 // Use 64 KiB for any unknown CPUs to be conservative.
-#if OS(DARWIN) || PLATFORM(PLAYSTATION) || CPU(MIPS) || CPU(MIPS64) || CPU(LOONGARCH64)
+// PS5 payloads (__PROSPERO__, PS5Term's Bun port) run with 16 KiB pages like the PlayStation port.
+#if OS(DARWIN) || PLATFORM(PLAYSTATION) || defined(__PROSPERO__) || CPU(MIPS) || CPU(MIPS64) || CPU(LOONGARCH64)
 constexpr size_t CeilingOnPageSize = 16 * KB;
 #elif USE(64KB_PAGE_BLOCK) || (OS(LINUX) && CPU(ARM64)) || CPU(PPC) || CPU(PPC64) || CPU(PPC64LE) || CPU(UNKNOWN)
 constexpr size_t CeilingOnPageSize = 64 * KB;
diff --git a/Source/WTF/wtf/StackBounds.cpp b/Source/WTF/wtf/StackBounds.cpp
index 8cea1e87..ca1c7f2f 100644
--- a/Source/WTF/wtf/StackBounds.cpp
+++ b/Source/WTF/wtf/StackBounds.cpp
@@ -208,9 +208,11 @@ WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
         }, &gnuStackSize);
         narrow(gnuStackSize & ~(pageSize - 1));
         // rlim_cur as exec left it (immune to a later setrlimit raise past the mapping) and as it is now.
+#ifdef AT_USRSTACKLIM // FreeBSD 14+; absent from the FreeBSD 11 ABI of PS5 payloads.
         unsigned long execStackLimit = 0;
         if (!elf_aux_info(AT_USRSTACKLIM, &execStackLimit, sizeof(execStackLimit)))
             narrow(execStackLimit);
+#endif
         rlimit limit;
         if (!getrlimit(RLIMIT_STACK, &limit) && limit.rlim_cur != RLIM_INFINITY)
             narrow(limit.rlim_cur);
