# PS5Term - the Linux build container "ps5term-build" (docs/DEVELOPMENT_LOOP.md), with what the
# Bun port needs on top of the host test compilers: LLVM 23 (the PS5 payload SDK picks the newest
# llvm-config), Ruby (WebKit's offlineasm), nasm (BoringSSL), CMake/Ninja, and rustup.
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   docker build -t ps5term-build -f tooling/bun-port/Dockerfile.build tooling/bun-port
#   docker run -d --name ps5term-build -v "$PWD:/work" -w /work ps5term-build sleep infinity
FROM ubuntu:24.04
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG LLVM_VERSION=23
# Same LLVM 23 debs (mirrored from apt.llvm.org) and checksum as WebKit's Dockerfile.freebsd.
ARG LLVM_DEBS_SHA256=993eba8b8ca23ea4d6074643d52ff9397b411e6ac5af6b7b2ca09dca2b351011
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget curl unzip xz-utils zip git rsync file cpio patch \
      cmake ninja-build make pkg-config ruby ruby-getoptlong perl python3 python3-venv \
      nasm gperf bison flex gcc g++ clang-18 lld-18 llvm-18 openssl openssh-client \
    && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:${LLVM_DEBS_SHA256} \
    https://github.com/oven-sh/WebKit/releases/download/llvm-${LLVM_VERSION}-debs/llvm-${LLVM_VERSION}-noble-amd64.tar.gz /tmp/llvm.tar.gz
RUN mkdir -p /tmp/llvm && tar xzf /tmp/llvm.tar.gz -C /tmp/llvm \
    && apt-get update && apt-get install -y /tmp/llvm/*.deb \
    && rm -rf /tmp/llvm /tmp/llvm.tar.gz /var/lib/apt/lists/*
# rustup itself; toolchains live in /work/.deps (RUSTUP_HOME/CARGO_HOME set by the build scripts).
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --no-modify-path --default-toolchain none --profile minimal \
    && mv /root/.cargo/bin/rustup /usr/local/bin/rustup && rm -rf /root/.cargo /root/.rustup /tmp/rustup.sh
